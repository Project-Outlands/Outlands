# generated source trees: these live in the project directory (not build/) so they can be read and diffed
/projects/mcpbase/minecraft/
/projects/mcpbase/patched/

!/.idea/icon.svg

/tools/**/__pycache__/
# the entry audit's cache of one pack's references: derived, and pack specific
/tools/entry-audit/refs.json

# run logs from the dev server/client
projects/*/logs/
projects/*/run/
projects/*/crash-reports/

# local notes and research write-ups stay out of the tree
/docs/

# editor and tool state: serena's language-server index is per checkout and machine
/.serena/
