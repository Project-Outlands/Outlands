+    private static final ThreadLocal<int[]> UPLOAD_SCRATCH = ThreadLocal.withInitial(() -> new int[0]);
+
+    private static int[] uploadScratch(int needed)
+    {
+        if (needed > UPLOAD_SCRATCH_LIMIT)
+        {
+            return new int[needed];
+        }
+
+        int[] scratch = UPLOAD_SCRATCH.get();
+
+        if (scratch.length < needed)
+        {
+            scratch = new int[needed];
+            UPLOAD_SCRATCH.set(scratch);
+        }
+
+        return scratch;
+    }
