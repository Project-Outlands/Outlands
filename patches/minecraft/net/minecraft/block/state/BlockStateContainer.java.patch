+     */
+    public static class Builder
+    {
+        private final Block block;
+        private final List<IProperty<?>> listed = Lists.newArrayList();
+        private final List<net.minecraftforge.common.property.IUnlistedProperty<?>> unlisted = Lists.newArrayList();
+
+        public Builder(Block block)
+        {
+            this.block = block;
+        }
+
+        public Builder add(IProperty<?>... props)
+        {
+            for (IProperty<?> prop : props)
+                this.listed.add(prop);
+            return this;
+        }
+
+        public Builder add(net.minecraftforge.common.property.IUnlistedProperty<?>... props)
+        {
+            for (net.minecraftforge.common.property.IUnlistedProperty<?> prop : props)
+                this.unlisted.add(prop);
+            return this;
+        }
+
+        public BlockStateContainer build()
+        {
+            IProperty<?>[] listed = new IProperty[this.listed.size()];
+            listed = this.listed.toArray(listed);
+            if (this.unlisted.size() == 0)
+                return new BlockStateContainer(this.block, listed);
+
+            net.minecraftforge.common.property.IUnlistedProperty<?>[] unlisted = new net.minecraftforge.common.property.IUnlistedProperty[this.unlisted.size()];
+            unlisted = this.unlisted.toArray(unlisted);
+
+            return new net.minecraftforge.common.property.ExtendedBlockState(this.block, listed, unlisted);
+        }
+    }
+    /**
+     * The stride grid a container's states sit on: one axis per property, the last property varying fastest.
+     *
+     * <p>Vanilla built an {@code ImmutableTable} per state holding "every neighbour reachable by changing one
+     * property", and looking a neighbour up hashed the property map again. Hashing a {@code PropertyEnum} walks all
+     * of its allowed values, so both halves were linear in the state's property tree, times every state - it is the
+     * single largest block of CPU in a launch.
+     *
+     * <p>Here the neighbour of a state is arithmetic: its index plus the signed stride of the changed property.
+     * States are placed by their own property values instead of the order the container happens to create them in,
+     * so nothing depends on {@link Cartesian}'s iteration order, and the per state table never has to exist.
+     */
+    public static final class Neighbourhood
+    {
+        private final int[] strides;
+        private final Object2IntMap<IProperty<?>> positions;
+        private final Object2IntMap<Comparable<?>>[] valueIndices;
+        private final IBlockState[] states;
+
+        @SuppressWarnings("unchecked")
+        Neighbourhood(BlockStateContainer container, List<? extends StateImplementation> created)
+        {
+            List<IProperty<?>> properties = ImmutableList.copyOf(container.properties.values());
+            int count = properties.size();
+            this.strides = new int[count];
+            this.valueIndices = new Object2IntMap[count];
+            this.positions = new Object2IntOpenHashMap<>(count);
+            this.positions.defaultReturnValue(-1);
+            int size = 1;
+
+            for (int i = count - 1; i >= 0; --i)
+            {
+                IProperty<?> property = properties.get(i);
+                Object2IntMap<Comparable<?>> values = new Object2IntOpenHashMap<>();
+                values.defaultReturnValue(-1);
+                int index = 0;
+
+                for (Comparable<?> value : property.getAllowedValues())
+                {
+                    values.put(value, index++);
+                }
+
+                int axis = values.size();
+                int grown = size * axis;
+
+                if (axis != 0 && grown / axis != size)
+                {
+                    throw new IllegalStateException("Too many block states for " + container);
+                }
+
+                this.strides[i] = size;
+                this.valueIndices[i] = values;
+                this.positions.put(property, i);
+                size = grown;
+            }
+
+            this.states = new IBlockState[size];
+
+            for (StateImplementation state : created)
+            {
+                int index = this.indexOf(state.getProperties());
+
+                if (index < 0 || index >= size || this.states[index] != null)
+                {
+                    throw new IllegalStateException("Block state " + state + " does not fit the property grid of " + container);
+                }
+
+                this.states[index] = state;
+            }
+
+            if (created.size() != size)
+            {
+                throw new IllegalStateException("Expected " + size + " block states for " + container + ", but got " + created.size());
+            }
+        }
+
+        int indexOf(ImmutableMap<IProperty<?>, Comparable<?>> properties)
+        {
+            int index = 0;
+
+            for (Entry<IProperty<?>, Comparable<?>> entry : properties.entrySet())
+            {
+                int position = this.positions.getInt(entry.getKey());
+
+                if (position < 0)
+                {
+                    return -1;
+                }
+
+                int value = this.valueIndices[position].getInt(entry.getValue());
+
+                if (value < 0)
+                {
+                    return -1;
+                }
+
+                index += value * this.strides[position];
+            }
+
+            return index;
+        }
+
+        @Nullable
+        IBlockState withProperty(int stateIndex, IProperty<?> property, Comparable<?> current, Comparable<?> wanted)
+        {
+            int position = this.positions.getInt(property);
+
+            if (position < 0 || stateIndex < 0)
+            {
+                return null;
+            }
+
+            Object2IntMap<Comparable<?>> values = this.valueIndices[position];
+            int from = values.getInt(current);
+            int to = values.getInt(wanted);
+
+            if (from < 0 || to < 0)
+            {
+                return null;
+            }
+
+            int target = stateIndex + (to - from) * this.strides[position];
+
+            return target >= 0 && target < this.states.length ? this.states[target] : null;
+        }
+    }
